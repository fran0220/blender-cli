#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
SECONDS=0
if [[ "$(uname -m)" != x86_64 ]]; then
  echo 'Blender orb setup requires Linux x86_64 precompiled libraries.' >&2
  exit 1
fi

echo '[setup] Checking Debian build prerequisites'
# Keep Clang tooling for formatting and editor integration; GCC below builds Blender.
packages=(build-essential clang-19 clang-format-19 clangd-19 lld-19 cmake ninja-build
  ccache curl ca-certificates git-lfs pkg-config python3 libx11-dev libxxf86vm-dev libxcursor-dev
  libxi-dev libxrandr-dev libxinerama-dev libxkbcommon-dev libwayland-dev
  wayland-protocols libdbus-1-dev libgl-dev libegl-dev)
missing=()
for package in "${packages[@]}"; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update -qq
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends "${missing[@]}"
fi
echo "[setup] System packages ready (${SECONDS}s)"

echo '[setup] Checking xPack GCC 14.3.0 and its runtime'
# Upstream requires GCC >= 14. Debian 12's libstdc++ also cannot compile its
# constexpr std::string with Clang; xPack uses the existing system sysroot.
if [[ "$(/opt/xpack-gcc/bin/g++ -dumpfullversion 2>/dev/null || true)" != 14.3.0 ]]; then
  archive="$(mktemp)"
  trap 'rm -f "$archive"' EXIT
  curl -fsSL --retry 3 -o "$archive" \
    https://github.com/xpack-dev-tools/gcc-xpack/releases/download/v14.3.0-1/xpack-gcc-14.3.0-1-linux-x64.tar.gz
  sudo mkdir -p /opt/xpack-gcc
  sudo tar -xzf "$archive" -C /opt/xpack-gcc --strip-components=1
  rm -f "$archive"
  trap - EXIT
fi
sudo cp -a /opt/xpack-gcc/lib64/libstdc++.so.6 \
  /opt/xpack-gcc/lib64/libstdc++.so.6.0.33 \
  /opt/xpack-gcc/lib64/libgcc_s.so.1 /usr/local/lib/
sudo ldconfig
echo "[setup] GCC runtime ready (${SECONDS}s)"

# Persist the compiler selection for Amp and services, scoped to this checkout.
marker='# Blender orb compiler environment'
if [[ -f "$HOME/.bash_profile" ]]; then
  # Migrate the old scoped hook, not unrelated compiler selections in the profile.
  sed -i '/^# Blender orb compiler environment$/,/^esac$/s|export CC=clang-19 CXX=clang++-19|export CC=/opt/xpack-gcc/bin/gcc CXX=/opt/xpack-gcc/bin/g++|' "$HOME/.bash_profile"
fi
if ! grep -Fqx "$marker" "$HOME/.bash_profile" 2>/dev/null; then
  cat >> "$HOME/.bash_profile" <<EOF

$marker
case "\$PWD" in
  "$repo_root"|"$repo_root"/*)
    export CC=/opt/xpack-gcc/bin/gcc CXX=/opt/xpack-gcc/bin/g++
    ;;
esac
EOF
fi

echo '[setup] Hydrating source assets and pinned Linux libraries'
git lfs install --local
# Match Blender's make_update.py fallback for forks without their own LFS data.
git config --local remote.lfs-fallback.url https://projects.blender.org/blender/blender.git
git config --local remote.lfs-fallback.pushurl no_push
# Fetch upstream explicitly: Debian's Git LFS does not retry origin's missing
# objects with remote.searchall alone. The local object cache makes this cheap warm.
git lfs pull lfs-fallback
echo "[setup] Source assets ready (${SECONDS}s total); fetching pinned libraries"
# Override update=none for this invocation only; never update Blender's branch.
GIT_LFS_SKIP_SMUDGE=1 git -c submodule.lib/linux_x64.update=checkout \
  submodule update --init --depth 1 -- lib/linux_x64
git -C lib/linux_x64 lfs pull
echo "[setup] Dependencies ready (${SECONDS}s total); Blender compilation is on demand"
